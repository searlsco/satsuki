#!/usr/bin/env python3
"""Assemble the single-file release export: dist/satsuki-<version>.json.

Bundles every data/ class file under one self-describing header, with the
hand-authored supplement (supplement/patterns.json) beside them under
`supplement`, and adds a derived `text` field per example (the ruby-stripped
sentence) so consumers don't need a ruby parser.
Usage: script/assemble <version>
"""
import glob
import json
import os
import sys
from datetime import date

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def strip_ruby(ruby):
    """Written form of an inline-ruby string, honoring backslash escapes."""
    out, i, depth = [], 0, 0
    while i < len(ruby):
        ch = ruby[i]
        if ch == "\\" and i + 1 < len(ruby):
            if depth == 0:
                out.append(ruby[i + 1])
            i += 2
            continue
        if ch == "[":
            depth += 1
        elif ch == "]":
            depth -= 1
            if depth < 0:
                raise ValueError(f"stray ] in {ruby!r}")
        elif depth == 0:
            out.append(ch)
        i += 1
    if depth != 0:
        raise ValueError(f"unterminated [ in {ruby!r}")
    return "".join(out)


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: script/assemble <version>")
    version = sys.argv[1]
    classes = []
    for path in sorted(glob.glob(f"{REPO}/data/*.json")):
        with open(path, encoding="utf-8") as source:
            cls = json.load(source)
        for pattern in cls["patterns"]:
            for example in pattern["examples"]:
                example["text"] = strip_ruby(example["ruby"])
        classes.append(cls)
    with open(f"{REPO}/supplement/patterns.json", encoding="utf-8") as source:
        supplement = json.load(source)
    for pattern in supplement["patterns"]:
        for example in pattern["examples"]:
            example["text"] = strip_ruby(example["ruby"])
    export = {
        "name": "satsuki",
        "version": version,
        "schema_version": 2,  # tracks the per-class satsuki_schema
        "description": (
            "English glosses, usage notes, and ruby-annotated example sentences"
            " for the Japanese functional expressions catalogued by the"
            " Tsutsuji dictionary, keyed by Tsutsuji l2_id."
        ),
        "license": "CC-BY-SA-4.0",
        "attribution": "Searls LLC — https://github.com/searlsco/satsuki",
        "upstream": {
            "name": "Tsutsuji (Matsuyoshi & Sato)",
            "version": "1.1u",
            "url": "https://sites.google.com/edu.teu.ac.jp/cl-lab/研究/言語資源/日本語機能表現辞書つつじ",
            "license": "CC-BY-SA-4.0",
        },
        "generated": date.today().isoformat(),
        "classes": classes,
        # Additive to schema 2: patterns and realizations Tsutsuji lacks,
        # authored for satsuki rather than taken from Tsutsuji.
        "supplement": supplement,
    }
    os.makedirs(f"{REPO}/dist", exist_ok=True)
    out_path = f"{REPO}/dist/satsuki-{version}.json"
    with open(out_path, "w") as f:
        json.dump(export, f, ensure_ascii=False, indent=1)
        f.write("\n")
    patterns = sum(len(c["patterns"]) for c in classes)
    examples = sum(len(p["examples"]) for c in classes for p in c["patterns"])
    print(f"{out_path}: {len(classes)} classes, {patterns} patterns,"
          f" {examples} examples, {len(supplement['patterns'])} supplement"
          f" patterns, {len(supplement['realizations'])} supplement"
          f" realizations, {os.path.getsize(out_path) / 1e6:.1f} MB")


if __name__ == "__main__":
    main()
